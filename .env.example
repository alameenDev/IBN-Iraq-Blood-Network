APP_NAME="IBN | Iraq Blood Network"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=ar
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ibn
DB_USERNAME=ibn_app
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=warning
# Required independent random key; generate with php -r 'echo bin2hex(random_bytes(32));'
IDENTITY_HASH_KEY=
